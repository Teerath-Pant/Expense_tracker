{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "app/web/dist",
  "builds": [
    {
      "src": "app/server/dist/index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/app/server/dist/index.js"
    },
    {
      "src": "/(.*)",
      "dest": "/app/web/dist/index.html"
    }
  ]
}