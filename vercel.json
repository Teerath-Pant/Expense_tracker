{
  "version": 2,
  "builds": [
    {
      "src": "app/server/dist/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "app/web/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/app/server/dist/index.js"
    },
    {
      "src": "/(.*)",
      "dest": "/app/web/dist/$1"
    }
  ]
}