{
  "name": "expense-tracker-server",
  "version": "1.0.0",
  "description": "oRPC + Express + Drizzle + PostgreSQL backend for Expense Tracker",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit",
    "test": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "dev": "wrangler dev",
    "db:migrate:local": "wrangler d1 migrations apply expense-tracker-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply expense-tracker-db --remote",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@orpc/client": "^1.14.3",
    "@orpc/server": "^1.14.3",
    "bcryptjs": "^3.0.2",
    "drizzle-orm": "^0.39.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.7",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "wrangler": "^4.168.0"
  }
}
